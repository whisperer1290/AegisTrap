# AegisTrap configuration. Copy to `.env` and edit. All values are optional;
# with no .env at all the system runs fully offline using the deterministic
# response engine (which is also the static baseline used in evaluation).

# ---------------------------------------------------------------------------
# LLM response engine
# ---------------------------------------------------------------------------
# offline   deterministic state renderer, no network, no key (default)
# anthropic Claude via Messages API
# openai    GPT via Chat Completions API
# ollama    local open-weight model (Llama / Mistral) via Ollama
AEGISTRAP_LLM_PROVIDER=offline

AEGISTRAP_ANTHROPIC_API_KEY=
AEGISTRAP_ANTHROPIC_MODEL=claude-sonnet-4-20250514

AEGISTRAP_OPENAI_API_KEY=
AEGISTRAP_OPENAI_MODEL=gpt-4o-mini

AEGISTRAP_OLLAMA_BASE_URL=http://localhost:11434
AEGISTRAP_OLLAMA_MODEL=llama3.1:8b

# Separate (usually stronger) model for the threat-intel auto-reporter.
# Leave blank to reuse the response-engine provider.
AEGISTRAP_REPORTER_PROVIDER=

# ---------------------------------------------------------------------------
# Attacker profiler
# ---------------------------------------------------------------------------
# heuristic   rule-based baseline (default, no model required)
# ml          trained RandomForest only
# hybrid      average of the rule-based and ML distributions
# ml/hybrid need data/profiler_model.joblib from `python -m aegistrap train-profiler`.
AEGISTRAP_PROFILER_MODE=heuristic

# ---------------------------------------------------------------------------
# Deception behaviour
# ---------------------------------------------------------------------------
# Emulated product persona: fintech | ecommerce
AEGISTRAP_PERSONA=fintech

# Enable the persona-adaptive vulnerability surface (Section 4 contribution).
# Set false for the no-profiling ablation used in evaluation.
AEGISTRAP_ADAPTIVE_DECEPTION=true

# Stretch goal (Section 4): mutate banners/headers to resist fingerprinting.
AEGISTRAP_FINGERPRINT_EVASION=false

# Reserve real LLM calls for interesting requests; serve cached/templated
# responses otherwise. Mitigates the latency tell described in Section 13.
AEGISTRAP_LLM_CACHE_ENABLED=true
AEGISTRAP_LLM_TIMEOUT_SECONDS=12.0

# ---------------------------------------------------------------------------
# Storage and reporting
# ---------------------------------------------------------------------------
AEGISTRAP_DB_PATH=data/aegistrap.sqlite3
AEGISTRAP_REPORT_DIR=reports

# A session is considered closed (and auto-reported) after this idle gap.
AEGISTRAP_SESSION_IDLE_SECONDS=300
AEGISTRAP_AUTO_REPORT_ENABLED=true
AEGISTRAP_REPORT_SWEEP_SECONDS=60

# Anonymise attacker IPs at rest (Section 10: ethics).
AEGISTRAP_ANONYMISE_IPS=false
AEGISTRAP_LOG_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
AEGISTRAP_DASHBOARD_ENABLED=true
# Optional shared secret for /dashboard. Strongly recommended if the honeypot
# is reachable from the internet.
AEGISTRAP_DASHBOARD_TOKEN=
